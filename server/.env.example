# Node Environment
NODE_ENV=production

# Server Port (Render/Heroku automatically sets PORT)
PORT=5000

# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/safeground?retryWrites=true&w=majority

# JWT Secret Key for Session Authentication
JWT_SECRET=safeground_production_secret_key_change_me_2025

# Allowed Client URL(s) for CORS (comma-separated or wildcard *)
CLIENT_URL=https://safeground.vercel.app,http://localhost:5173

# Optional: OpenAI API Key for Live GPT-4o Risk Insights (fallback engine used if omitted)
AI_API_KEY=
AI_MODEL=gpt-4o-mini
